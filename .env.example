# Adresse de base de l'API Spring Boot, sans secret côté navigateur.
# Vide : port 8080 de la machine qui sert la page (localhost, ou son adresse réseau depuis un téléphone).
VITE_API_BASE_URL=http://localhost:8080
# Adresse publique du site, utilisée dans le lien de partage et le QR code.
# Vide : adresse de la page ouverte. Pour scanner un QR code avec un téléphone en développement,
# indiquez l'adresse réseau de l'ordinateur, ex. http://192.168.1.20:5173 (et lancez « npm run dev -- --host »).
VITE_PUBLIC_APP_URL=
